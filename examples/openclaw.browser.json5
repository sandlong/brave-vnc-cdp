{
  browser: {
    enabled: true,
    defaultProfile: "chromium-local",
    remoteCdpTimeoutMs: 30000,
    remoteCdpHandshakeTimeoutMs: 45000,
    ssrfPolicy: {
      // WARNING: This disables SSRF protection for private-network requests.
      // Only use in trusted local-development environments where the browser
      // cannot reach sensitive internal services.
      dangerouslyAllowPrivateNetwork: true,
    },
    profiles: {
      chromium-local: {
        cdpUrl: "http://127.0.0.1:9222",
        color: "#3B82F6",
      },
    },
  },
}
